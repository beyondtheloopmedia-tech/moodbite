# Supabase is optional. Without these, Moodbite still runs: preferences live in
# localStorage, there are no accounts, and nothing else changes.
#
# Both values are safe to expose to the browser. The anon key is protected by
# row level security, which 0001_profiles.sql sets up so a row is only ever
# readable by the user it belongs to.
#
# Project Settings -> API, in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://bvykfeqbwzxztuhnkhtj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
